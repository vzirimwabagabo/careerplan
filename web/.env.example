# Supabase connection. Both values are safe to expose to the browser:
# the publishable key is designed to be public and is protected by the
# row level security policies in supabase/migrations/0001_init.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx
